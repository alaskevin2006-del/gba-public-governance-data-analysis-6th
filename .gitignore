# macOS 压缩包元数据（无实际数据）
__MACOSX/
._*

# 系统/Office 临时文件
Thumbs.db
desktop.ini
.DS_Store
~$*

# 本地工具缓存与笔记（不上传）
.workbuddy/

# 归档区：冗余副本与损坏源包，内容已在 data/ 展开
.archive/

# MiroFish 仿真产物（体积大、含临时日志）
mirofish/outputs/*
!mirofish/outputs/.gitkeep

# MiroFish 本地部署（按需 clone，不入库）
MiroFish/

# 密钥
.env
.env.*
!.env.example
